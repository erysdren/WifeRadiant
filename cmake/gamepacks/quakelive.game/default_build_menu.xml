<?xml version="1.0"?>
<!--
build commands
[RadiantPath]: path to Radiant .. C:\Program Files\Gtkradiant
[EnginePath]: path to the engine .. C:\quake3\ C:\Program Files\Quake III Arena\ /usr/local/games/quake3/
-->
<project version="2.0">
<var name="wrmap">"[RadiantPath]wrmap.[ExecutableType]" -v<cond value="[MonitorAddress]"> -connect [MonitorAddress]</cond> -game quakelive -fs_basepath "[EnginePath]"<cond value="[GameName]"> -fs_game [GameName]</cond></var>
<var name="mbspc">"[RadiantPath]mbspc.[ExecutableType]"</var>
<build name="Single: bsp">
<command>[wrmap] -meta "[MapFile]"</command>
</build>
<build name="Single: vis">
<command>[wrmap] -vis -saveprt "[MapFile]"</command>
</build>
<build name="Single: light">
<command>[wrmap] -light -fast "[MapFile]"</command>
</build>
<separator />
<build name="[test] quick and very crude">
<command>[wrmap] -meta -samplesize 64 "[MapFile]"</command>
<command>[wrmap] -vis -fast -saveprt "[MapFile]"</command>
<command>[wrmap] -light -fast -nogrid "[MapFile]"</command>
</build>
<separator />
<build name="(Final)">
<command>[wrmap] -meta "[MapFile]"</command>
<command>[wrmap] -vis "[MapFile]"</command>
<command>[wrmap] -light -fast -patchshadows -samples 2 -filter -bounce 8 "[MapFile]"</command>
</build>
<build name="QL-Official">
<command>[wrmap] -meta "[MapFile]"</command>
<command>[wrmap] -vis "[MapFile]"</command>
<command>[wrmap] -light -bounce 8 -fastbounce -dark -dirtdepth 32 -dirtscale 3 -dirty -patchshadows -samples 3 -scale 1.2 -shade -cpma "[MapFile]"</command>
</build>
<separator />
<build name="convert to .ASE">
<command>[wrmap] -meta -patchmeta "[MapFile]"</command>
<command>[wrmap] -convert -format ase -shadersasbitmap "[BspFile]"</command>
</build>
<build name="convert to .OBJ">
<command>[wrmap] -meta -patchmeta "[MapFile]"</command>
<command>[wrmap] -convert -format obj -shadersasbitmap "[BspFile]"</command>
</build>
<separator />
<build name="make .pk3">
<command>[wrmap] -pk3 -png "[BspFile]"</command>
</build>
<build name="make .aas">
<command>[mbspc] -forcesidesvisible -optimize -bsp2aas &quot;[BspFile]&quot;</command>
</build>
</project>

