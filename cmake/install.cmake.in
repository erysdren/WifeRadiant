file(GET_RUNTIME_DEPENDENCIES
	RESOLVED_DEPENDENCIES_VAR _resolved_deps
	UNRESOLVED_DEPENDENCIES_VAR _unresolved_deps
	EXECUTABLES
		$<TARGET_FILE:@_target_name@>
	PRE_EXCLUDE_REGEXES
		"api-ms-" "ext-ms-" "Qt6"
	POST_EXCLUDE_REGEXES
		".*system32/.*\\.dll"
	DIRECTORIES
		$<TARGET_RUNTIME_DLL_DIRS:@_target_name@>
)
if(_unresolved_deps)
	message(WARNING "@_target_name@ unresolved dependencies: ${_unresolved_deps}")
endif()
file(COPY ${_resolved_deps} DESTINATION $<TARGET_FILE_DIR:@_target_name@>)
