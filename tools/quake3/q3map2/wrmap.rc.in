101                     ICON    DISCARDABLE     "@WRMAP_RC_ICON_FILENAME@"

#define VS_FF_DEBUG 0x1L
#define VS_VERSION_INFO 0x1L
#define VS_FFI_FILEFLAGSMASK 0x17L
#define VER_PRIVATEBUILD 0x0L
#define VER_PRERELEASE 0x0L
#define VOS__WINDOWS32 0x4L
#define VFT_APP 0x1L
#define VFT2_UNKNOWN 0x0L

#ifdef _DEBUG
#define VER_DEBUG VS_FF_DEBUG
#else
#define VER_DEBUG 0
#endif

VS_VERSION_INFO VERSIONINFO
FILEVERSION     @WRMAP_RC_FILEVERSION@
PRODUCTVERSION  @WRMAP_RC_FILEVERSION@
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
FILEFLAGS       VER_DEBUG
FILEOS          VOS__WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      "WifeSoft Gameware\0"
            VALUE "FileDescription",  "Compiled with @CMAKE_CXX_COMPILER_ID@ @CMAKE_CXX_COMPILER_VERSION@\0"
            VALUE "FileVersion",      "@WRMAP_VERSION@\0"
            VALUE "InternalName",     "wrmap\0"
            VALUE "LegalCopyright",   "Copyright (C) 2025-2026 erysdren (it/its)\0"
            VALUE "License",          "GPL2\0"
            VALUE "Info",             "https://wiferadiant.org/\0"
            VALUE "OriginalFilename", "@WRMAP_RC_ORIGINAL_FILENAME@\0"
            VALUE "ProductName",      "wrmap\0"
            VALUE "ProductVersion",   "@WRMAP_VERSION@\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
